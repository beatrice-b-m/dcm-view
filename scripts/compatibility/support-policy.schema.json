{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcmview.local/schemas/support-policy-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "outcomes", "rules"],
  "properties": {
    "policy_version": {"const": "1.0.0"},
    "outcomes": {"type": "array", "items": {"enum": ["pixel_faithful_interactive", "pixel_preview", "metadata_reference_navigation", "controlled_unsupported", "out_of_scope", "temporarily_unverified"]}, "uniqueItems": true},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "precedence", "match", "classification", "required_assertions", "semantic_context_assertions", "expected_unsupported", "rationale", "exclusions"],
      "properties": {
        "id": {"type": "string"}, "precedence": {"type": "integer"},
        "match": {"type": "object"},
        "classification": {"type": "string"},
        "required_assertions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "semantic_context_assertions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "expected_unsupported": {"type": ["object", "null"]},
        "rationale": {"type": "string"}, "exclusions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
