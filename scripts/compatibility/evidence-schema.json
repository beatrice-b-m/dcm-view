{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcmview.local/schemas/compatibility-evidence-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_schema_version", "generated_at", "suite", "viewer", "run", "results", "summary", "artifacts"],
  "properties": {
    "evidence_schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string"},
    "suite": {"type": "object", "required": ["commit", "manifests", "policy_sha256"]},
    "viewer": {"type": "object", "required": ["binary", "sha256", "version", "commit", "build_features"]},
    "run": {"type": "object"},
    "results": {"type": "array", "items": {"type": "object", "required": ["profile", "case_id", "path", "status", "policy", "assertions", "observations", "http", "timings_ms", "errors", "payload_hashes"]}},
    "summary": {"type": "object", "required": ["statuses", "by_object_family", "by_transfer_syntax", "by_classification", "by_dimension"]},
    "artifacts": {"type": "array"}
  }
}
