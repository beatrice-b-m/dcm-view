{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcmview.local/schemas/compatibility-detail-0.1.0.json",
  "title": "DICOM View compatibility campaign detail",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detail_schema_version",
    "generated_at",
    "worklist",
    "viewer",
    "run",
    "results",
    "summary",
    "artifacts",
    "validation"
  ],
  "properties": {
    "detail_schema_version": {"const": "0.1.0"},
    "generated_at": {"type": "string"},
    "worklist": {
      "type": "object",
      "required": ["path", "sha256", "content_sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "viewer": {
      "type": "object",
      "required": ["binary", "sha256", "version"],
      "additionalProperties": false,
      "properties": {
        "binary": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string"}
      }
    },
    "run": {"type": "object"},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "summary": {"type": "object"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "validation": {
      "type": "object",
      "required": ["schema", "schema_sha256", "status"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "detail-schema.json"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "passed"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {
      "type": "object",
      "required": [
        "root", "case_id", "path", "identity", "execution_safety",
        "compatibility", "expected_capabilities", "observations", "http",
        "timings_ms", "errors"
      ]
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "path", "sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string"},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
