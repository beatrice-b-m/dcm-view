{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcmview.local/schemas/compatibility-corpus-lock-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock_version", "suite", "generation", "profiles"],
  "properties": {
    "lock_version": {"const": "1.0.0"},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "manifest_schema_sha256", "viewer_report_schema_sha256", "registry_sha256", "cargo_lock_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_schema_sha256": {"$ref": "#/$defs/sha256"},
        "viewer_report_schema_sha256": {"$ref": "#/$defs/sha256"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "cargo_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "generation": {
      "type": "object",
      "required": ["seed", "cargo_features", "command", "tools"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "cargo_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "command": {"type": "string"},
        "tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "legacy", "negative", "stress", "fuzz"],
      "patternProperties": {
        "^(all|legacy|negative|stress|fuzz)$": {
          "type": "object",
          "required": ["physical_files", "logical_cases", "qualifications", "manifest_sha256"],
          "properties": {
            "physical_files": {"type": "integer", "minimum": 0},
            "logical_cases": {"type": "integer", "minimum": 0},
            "qualifications": {"type": "integer", "minimum": 0},
            "manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
