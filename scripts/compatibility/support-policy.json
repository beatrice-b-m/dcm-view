{
  "$schema": "support-policy.schema.json",
  "policy_version": "1.0.0",
  "outcomes": ["pixel_faithful_interactive", "pixel_preview", "metadata_reference_navigation", "controlled_unsupported", "out_of_scope", "temporarily_unverified"],
  "rules": [
    {
      "id": "negative_isolated_robustness", "precedence": 1000, "match": {"profiles": ["negative"]},
      "classification": "controlled_unsupported", "required_assertions": ["negative_bounded_outcome", "server_recovers_after_error"], "semantic_context_assertions": [],
      "expected_unsupported": {"statuses": ["discovery_skip", 404, 422, 500], "error_behavior": "stable_non_panicking_error_or_policy_tolerated_partial_inspection"},
      "rationale": "Malformed inputs are inspected only within their suite-declared acceptable outcomes.", "exclusions": ["DICOM conformance grading"]
    },
    {
      "id": "payload_free_fuzz_qualification", "precedence": 990, "match": {"profiles": ["fuzz"]},
      "classification": "out_of_scope", "required_assertions": ["fuzz_qualification_bounded"], "semantic_context_assertions": [], "expected_unsupported": null,
      "rationale": "The upstream fuzz profile supplies qualification evidence but no reusable payload corpus.", "exclusions": ["treating upstream same-project fuzzing as dcmview fuzz evidence"]
    },
    {
      "id": "reduced_stress_baseline", "precedence": 980, "match": {"profiles": ["stress"]},
      "classification": "temporarily_unverified", "required_assertions": ["stress_bounded_execution", "stress_resource_measurements", "server_recovers_after_error"], "semantic_context_assertions": [], "expected_unsupported": null,
      "rationale": "Reduced stress cases establish measured baselines before reviewed thresholds exist.", "exclusions": ["full-scale stress claims", "unreviewed hard limits"]
    },
    {
      "id": "unsupported_compressed_transfer_syntaxes", "precedence": 900,
      "match": {"transfer_syntax_uids": ["1.2.840.10008.1.2.4.51", "1.2.840.10008.1.2.4.81", "1.2.840.10008.1.2.4.91", "1.2.840.10008.1.2.4.111", "1.2.840.10008.1.2.4.112", "1.2.840.10008.1.2.4.201", "1.2.840.10008.1.2.4.203"]},
      "classification": "controlled_unsupported", "required_assertions": ["discovery_identity", "metadata_exact", "controlled_unsupported_error", "server_recovers_after_error"], "semantic_context_assertions": [],
      "expected_unsupported": {"statuses": [422], "error_behavior": "unsupported_transfer_syntax_json"},
      "rationale": "These transfer syntaxes remain unqualified or unsupported by the viewer decoder paths.", "exclusions": ["capability by whitelist name", "silent approximate rendering"]
    },
    {
      "id": "segmentation_pixel_preview", "precedence": 850,
      "match": {"sop_class_uids": ["1.2.840.10008.5.1.4.1.1.66.4", "1.2.840.10008.5.1.4.1.1.66.7"]},
      "classification": "pixel_preview", "required_assertions": ["discovery_identity", "metadata_exact", "raw_lossless_all_frames", "display_normalized_pixels", "frame_navigation", "cache_miss_hit"],
      "semantic_context_assertions": ["segmentation_context", "segment_reference_closure", "segmentation_overlay_eligibility", "semantic_toggle_preserves_raw"], "expected_unsupported": null,
      "rationale": "SEG defaults to stored-pixel preview; semantic source alignment is an explicit, validated capability.", "exclusions": ["unvalidated source overlay", "clinical segmentation interpretation"]
    },
    {
      "id": "parametric_map_pixel_preview", "precedence": 850, "match": {"sop_class_uids": ["1.2.840.10008.5.1.4.1.1.30"]},
      "classification": "pixel_preview", "required_assertions": ["discovery_identity", "metadata_exact", "raw_lossless_all_frames", "display_normalized_pixels", "frame_navigation"],
      "semantic_context_assertions": ["parametric_map_context", "rwvm_mapping", "stored_mapped_identity", "semantic_toggle_preserves_raw"], "expected_unsupported": null,
      "rationale": "Parametric maps expose stored floats by default and apply only explicit RWVM in semantic context.", "exclusions": ["inferred mappings", "clinical quantitative interpretation"]
    },
    {
      "id": "rt_dose_pixel_preview", "precedence": 850, "match": {"sop_class_uids": ["1.2.840.10008.5.1.4.1.1.481.2"]},
      "classification": "pixel_preview", "required_assertions": ["discovery_identity", "metadata_exact", "raw_lossless_all_frames", "display_normalized_pixels", "frame_navigation"],
      "semantic_context_assertions": ["rt_dose_context", "dose_grid_scaling", "dose_overlay_eligibility", "semantic_toggle_preserves_raw"], "expected_unsupported": null,
      "rationale": "RT Dose defaults to stored-pixel preview; scaling and geometry are explicitly labelled context.", "exclusions": ["prescription correctness", "clinical acceptability"]
    },
    {
      "id": "wsi_positioned_tile_preview", "precedence": 840, "match": {"sop_class_uids": ["1.2.840.10008.5.1.4.1.1.77.1.6"]},
      "classification": "pixel_faithful_interactive", "required_assertions": ["discovery_identity", "metadata_exact", "raw_lossless_all_frames", "display_normalized_pixels", "frame_navigation", "wsi_tile_position", "wsi_minimap_metadata"],
      "semantic_context_assertions": [], "expected_unsupported": null,
      "rationale": "WSI support is limited to decoded, positioned individual tiles with metadata-driven context.", "exclusions": ["Total Pixel Matrix reconstruction", "tile stitching", "slide-wide panning"]
    },
    {
      "id": "metadata_reference_objects", "precedence": 800,
      "match": {"sop_class_uids": ["1.2.840.10008.5.1.4.1.1.66.1", "1.2.840.10008.5.1.4.1.1.66.3", "1.2.840.10008.5.1.4.1.1.67", "1.2.840.10008.5.1.4.1.1.11.1", "1.2.840.10008.5.1.4.1.1.11.2", "1.2.840.10008.5.1.4.1.1.11.4", "1.2.840.10008.5.1.4.1.1.11.8", "1.2.840.10008.5.1.4.1.1.88.11", "1.2.840.10008.5.1.4.1.1.88.33", "1.2.840.10008.5.1.4.1.1.88.34", "1.2.840.10008.5.1.4.1.1.88.59", "1.2.840.10008.5.1.4.1.1.9.1.1", "1.2.840.10008.5.1.4.1.1.9.1.2", "1.2.840.10008.5.1.4.1.1.481.1", "1.2.840.10008.5.1.4.1.1.481.3", "1.2.840.10008.5.1.4.1.1.481.5", "1.2.840.10008.5.1.4.1.1.481.12", "1.2.840.10008.5.1.4.1.1.481.13", "1.2.840.10008.5.1.4.1.1.104.1", "1.2.840.10008.5.1.4.1.1.104.3"]},
      "classification": "metadata_reference_navigation", "required_assertions": ["discovery_identity", "metadata_exact", "reference_closure", "no_misleading_renderer"], "semantic_context_assertions": [], "expected_unsupported": null,
      "rationale": "Non-image and dedicated semantic objects remain navigable without claiming a renderer.", "exclusions": ["waveform display", "presentation-state application", "registration transforms", "SR interpretation", "document or mesh rendering", "RT planning interpretation"]
    },
    {
      "id": "qualified_generic_images", "precedence": 100, "match": {"profiles": ["all", "legacy"], "has_image": true},
      "classification": "pixel_faithful_interactive", "required_assertions": ["discovery_identity", "metadata_exact", "raw_lossless_all_frames", "lossy_numeric_thresholds", "display_normalized_pixels", "presentation_pipeline", "frame_navigation", "series_geometry", "reference_closure", "cache_miss_hit", "server_recovers_after_error"],
      "semantic_context_assertions": [], "expected_unsupported": null,
      "rationale": "Classic, enhanced, VL, and ordinary multiframe image families use assertion-backed generic inspection.", "exclusions": ["advanced enhanced dimensions", "clinical diagnostic fidelity beyond declared presentation assertions"]
    },
    {
      "id": "remaining_valid_metadata", "precedence": 10, "match": {"profiles": ["all", "legacy"], "has_image": false},
      "classification": "metadata_reference_navigation", "required_assertions": ["discovery_identity", "metadata_exact", "reference_closure", "no_misleading_renderer"], "semantic_context_assertions": [], "expected_unsupported": null,
      "rationale": "Valid local instances without an image contract remain available for tags and reference navigation.", "exclusions": ["renderer inference from SOP recognition"]
    }
  ]
}
